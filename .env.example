# -------------------------------------------------------------------------
# Environment variables for the Access-Governed RAG Console.
#
# Copy this file to a private, gitignored location or set these directly in
# your shell. NEVER commit real secret values.
#
# On Windows PowerShell, set each with:
#   $env:VARNAME="value"
# On macOS/Linux:
#   export VARNAME="value"
# -------------------------------------------------------------------------

# --- Required for real LLM generation ---
# Your Anthropic API key. Without it, the app runs but the "answered" path
# returns a generation error instead of a real answer.
ANTHROPIC_API_KEY=sk-ant-...

# --- Required for session security ---
# Any long random string. Signs the Flask session cookie.
# Generate one with:  python -c "import os; print(os.urandom(32).hex())"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# --- Optional: Microsoft Entra ID (OAuth2) sign-in ---
# If ALL THREE of these are set (and msal is installed), the app shows a
# "Sign in with Microsoft" button and enables the real OAuth2 flow. If any
# are missing, the button is hidden and the app runs demo-login-only.
#
# ENTRA_CLIENT_ID  = your App Registration's Application (client) ID
# ENTRA_TENANT_ID  = your Directory (tenant) ID
# ENTRA_CLIENT_SECRET = the client secret VALUE (not the Secret ID)
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=

# Optional. Defaults to http://localhost:5000/auth/callback if unset.
# Must exactly match a redirect URI registered on the App Registration.
ENTRA_REDIRECT_URI=http://localhost:5000/auth/callback
